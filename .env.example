# SDTM Spec Gen - Environment Variables
# Copy this file to .env and fill in your values

# CDISC Library API Key (required for fetching specs)
# Get your API key from: https://www.cdisc.org/cdisc-library
CDISC_API_KEY=your_api_key_here

# Flask Configuration
PORT=5050
DEBUG=true

# Optional: React App API URL (for development)
# REACT_APP_API_URL=http://localhost:5050
